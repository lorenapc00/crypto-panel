{
  "name": "crypto-panel",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@10.15.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @crypto-panel/web dev",
    "dev:api": "pnpm --filter @crypto-panel/api dev",
    "build": "pnpm -r run build",
    "test": "node --test scripts/*.test.mjs && pnpm --filter @crypto-panel/api test",
    "research:probe": "pnpm --filter @crypto-panel/api research:probe",
    "research:budget": "node scripts/quota-budget.mjs"
  }
}
